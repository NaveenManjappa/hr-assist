
APP_ENV=
OPENAI_API_KEY=
CHAT_MODEL=
MAX_OUTPUT_TOKENS=
# none, low (default), medium, high, xhigh or max. Reasoning tokens count against
# MAX_OUTPUT_TOKENS, so a higher effort needs a higher cap.
# REASONING_EFFORT=low
EMBEDDING_MODEL=
# chunking_v1 or chunking_v2 (default), for both ingestion and the API (ADR 0005).
# CHUNKING_VERSION=chunking_v1
CHUNKING_VERSION=chunking_v2

# The strategy's chunk size limit and overlap, used at ingestion. Unset means the version's
# defaults. Only the version names the collection, so new sizes replace its chunks.
# CHUNK_MAX_TOKENS=500
# CHUNK_OVERLAP_TOKENS=100

# Chunks retrieved per question, and recent messages kept in the prompt.
# RETRIEVAL_K=3
# The lowest relevance a chunk needs, on a (cosine + 1) / 2 scale. When none passes, the
# reply is an abstention with no model call. 0 turns the filter off.
# RETRIEVAL_SCORE_THRESHOLD=0.65
# HISTORY_TURNS=5

QDRANT_URL=
QDRANT_API_KEY=

# The retriever eval's judge model (ADR 0006). 
# EVAL_JUDGE_MODEL=gpt-5.6-luna

LANGSMITH_API_KEY=
LANGSMITH_TRACING=
LANGSMITH_PROJECT=
# Only for EU-region LangSmith accounts:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Origin the Angular app is served from (CORS).
# FRONTEND_ORIGIN=http://localhost:4200

# Usage limits on POST /api/chat (UTC days).
# RATE_LIMIT_PER_MINUTE=20
# RATE_LIMIT_PER_DAY=100
# RATE_LIMIT_GLOBAL_PER_DAY=1000
# X-Forwarded-For entries, from the right, added by proxies you trust.
# TRUSTED_PROXY_HOPS=1
